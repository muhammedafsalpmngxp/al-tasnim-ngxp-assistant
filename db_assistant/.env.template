# .env.template - Copy to .env and fill in your values

# Database
DB_SERVER=your_server_name
DB_NAME=AppMasterDB
DB_READONLY_USER=NGXP_ReadOnly
DB_READONLY_PASSWORD=your_password

# LLM Provider: "gemini" or "local"
LLM_PROVIDER=local

# Gemini (only when LLM_PROVIDER=gemini)
GOOGLE_API_KEY=your_google_api_key
GEMINI_MODEL_NAME=gemini-2.0-flash

# Local Ollama (only when LLM_PROVIDER=local)
MODEL_NAME=qwen3:8b
TEMPERATURE=0.1
MAX_TOKENS=800
LLM_TIMEOUT_SEC=120

# Limits
MAX_ROWS=1000
QUERY_TIMEOUT_SEC=30
POOL_SIZE=10

# Value Resolution
FUZZY_THRESHOLD=80
AMBIGUITY_MARGIN=10

# Logging
LOG_LEVEL=INFO
LOG_FILE=db_assistant.log
