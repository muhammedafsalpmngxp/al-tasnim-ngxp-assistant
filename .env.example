# =============================================================================
# AL TASNIM Agentic AI — Root Environment Configuration
# One file configures both the orchestrator and the DB assistant.
# cp .env.example .env   →   fill in real values. Never commit .env to git.
# =============================================================================

# =============================================================================
# LLM PROVIDER
# "groq"   = Groq Cloud  (fast, free tier available — recommended)
# "gemini" = Google Gemini
# "local"  = Ollama (self-hosted, no API key needed)
# =============================================================================
LLM_PROVIDER=groq

# --- Groq (active when LLM_PROVIDER=groq) ---
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL_NAME=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.0

# --- Google Gemini (active when LLM_PROVIDER=gemini) ---
# GOOGLE_API_KEY=your_google_api_key
# GEMINI_MODEL_NAME=gemini-2.0-flash

# --- Ollama local (active when LLM_PROVIDER=local) ---
# LLM_MODEL=qwen2.5:7b

# --- Shared LLM settings ---
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SEC=120

# =============================================================================
# DATABASE  (read-only SQL Server user — never use a write-capable account)
# =============================================================================
DB_SERVER=your_sql_server_ip
DB_NAME=AppMasterDB
DB_READONLY_USER=your_readonly_user
DB_READONLY_PASSWORD=your_password

# =============================================================================
# ORCHESTRATOR
# =============================================================================
DB_ENV_FILE=.env
DB_TOOL_TIMEOUT=120

# How long (seconds) to wait for pipeline first-run init (model download + schema discovery + index build).
# Increase on slow servers or large databases.
PIPELINE_INIT_WAIT_SEC=1800

# Set VALUE_INDEX_ENABLED=1 to enable value-grounding (samples DB values for WHERE hints).
# Disabled by default — adds 5-15 min to first-run init on large DBs (500+ tables).
VALUE_INDEX_ENABLED=0

# Semantic routing threshold: minimum cosine similarity to count as a DB match.
# Range 0.0-1.0. Default 0.25 works well for BGE-small embeddings.
DB_ROUTE_THRESHOLD=0.25

RAG_TOOL_URL=http://localhost:8002
RAG_TOOL_TIMEOUT=60
RAG_TOP_K=5
RAG_RETRIES=2

MAX_ITERATIONS=5
RECURSION_LIMIT=12
HOST=0.0.0.0
PORT=8001
RELOAD=false

# =============================================================================
# OBSERVABILITY
# LangSmith gives you full trace visibility into every LangGraph step.
# 1. Create a free account at https://smith.langchain.com
# 2. Go to Settings → API Keys → Create API Key
# 3. Set LANGSMITH_TRACING=true and paste your key below.
# =============================================================================
LOG_LEVEL=INFO
# LOG_FILE=orchestrator.log      # uncomment to write logs to a file

LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=lsv2_pt_...  # your LangSmith API key (also called LANGCHAIN_API_KEY)
LANGSMITH_PROJECT=al-tasnim-orchestrator
