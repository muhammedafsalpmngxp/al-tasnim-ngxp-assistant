# =============================================================================
# AL TASNIM Agentic AI — Single Root .env
# Lives next to requirements.txt / .gitignore / docker-compose.yml
# Copy to .env and fill in real values. Never commit .env to git.
# =============================================================================

# =============================================================================
# LLM PROVIDER — shared by orchestrator + db_assistant
# "local" or "ollama" = Ollama (must support tool-calling, e.g. qwen2.5:7b)
# "gemini"            = Google Gemini (requires GOOGLE_API_KEY below)
# =============================================================================
LLM_PROVIDER=local

# Orchestrator LLM (must support tool-calling)
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SEC=120

# DB-assistant LLM (intent parsing + response formatting)
MODEL_NAME=qwen3:8b
TEMPERATURE=0.1
MAX_TOKENS=800

# Gemini (only required when LLM_PROVIDER=gemini)
# GOOGLE_API_KEY=your_google_api_key
# GEMINI_MODEL_NAME=gemini-2.0-flash

# =============================================================================
# DATABASE (db_assistant — read-only SQL Server user)
# =============================================================================
DB_SERVER=your_sql_server_ip
DB_NAME=AppMasterDB
DB_READONLY_USER=NGXP_ReadOnly
DB_READONLY_PASSWORD=your_password

# =============================================================================
# ORCHESTRATOR
# =============================================================================
DB_ENV_FILE=.env              # this file — db_assistant reads DB_* from here
DB_TOOL_TIMEOUT=60

RAG_TOOL_URL=http://localhost:8002
RAG_TOOL_TIMEOUT=60
RAG_TOP_K=5
RAG_RETRIES=2

MAX_ITERATIONS=5
RECURSION_LIMIT=12
HOST=0.0.0.0
PORT=8001
RELOAD=false

# =============================================================================
# DB ASSISTANT LIMITS
# =============================================================================
MAX_ROWS=1000
QUERY_TIMEOUT_SEC=30
POOL_SIZE=10
FUZZY_THRESHOLD=80
AMBIGUITY_MARGIN=10

# =============================================================================
# OBSERVABILITY
# =============================================================================
LOG_LEVEL=INFO
# LOG_FILE=orchestrator.log
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=your_key
LANGSMITH_PROJECT=al-tasnim-orchestrator
