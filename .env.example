# Copy this file to .env and fill in your values.
# .env is gitignored — never commit actual credentials.

# ── Database ────────────────────────────────────────────────────────────────
PG_URL=postgresql://YOUR_USER@/altasnim?host=/var/run/postgresql

# ── LLM provider ─────────────────────────────────────────────────────────────
# Set to "groq" for cloud or "ollama" for local
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_URL=http://localhost:11434

# Groq (used when LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here

# ── Embedding model ───────────────────────────────────────────────────────────
EMBED_MODEL=BAAI/bge-m3

# ── RAG server ────────────────────────────────────────────────────────────────
RAG_URL=http://localhost:8000

# ── Auth / RBAC ───────────────────────────────────────────────────────────────
# Format: apikey:role:display_name  (comma-separated for multiple keys)
# Roles defined in config/rbac_config.yaml
# Leave blank to run in dev mode (all requests treated as ngxp_admin)
AL_TASNIM_API_KEYS=your-admin-key:ngxp_admin:Admin,your-ops-key:al_tasnim_ops:OpsUser

# ── Test suite keys (10_test_all.py) ─────────────────────────────────────────
TEST_ADMIN_KEY=your-admin-key
TEST_OPS_KEY=your-ops-key

# ── Alerts engine (scripts/alerts_engine.py) ─────────────────────────────────
# SMTP for email delivery — leave blank for console-only alerts (dev mode)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=alerts@ngxptechnologies.com
SMTP_PASS=your_smtp_password
SMTP_FROM=altasnim-alerts@ngxptechnologies.com

ALERT_OPS_EMAIL=ops-team@altasnim.com
ALERT_PLANNING_EMAIL=planning@altasnim.com
ALERT_MGMT_EMAIL=management@altasnim.com

# ── RSR / SCR watcher (scripts/rsr_scr_watcher.py) ───────────────────────────
RSR_PLANNER_EMAIL=planner@altasnim.com
RSR_CIVIL_EMAIL=civil.exec@altasnim.com
RSR_CM_EMAIL=construction.manager@altasnim.com
RSR_PERMIT_EMAILS=permit1@altasnim.com,permit2@altasnim.com
