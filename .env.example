# =============================================================================
# AL TASNIM DB Assistant — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Microsoft SQL Server)
# -----------------------------------------------------------------------------
DB_SERVER=20.98.112.250
DB_NAME=AppMasterDB_Local
DB_USER=SA
DB_PASSWORD=your_password_here
DB_DRIVER=ODBC Driver 17 for SQL Server

# -----------------------------------------------------------------------------
# LLM Provider
# Choose one: groq | gemini | local | openai
# -----------------------------------------------------------------------------
LLM_PROVIDER=groq

# --- Groq Cloud (active when LLM_PROVIDER=groq) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.0

# --- Google Gemini (active when LLM_PROVIDER=gemini) ---
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash

# --- OpenAI (active when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_TEMPERATURE=0.0

# --- Ollama Local (active when LLM_PROVIDER=local) ---
# Requires Ollama running locally — no API key needed.
LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# Embedding Model (HuggingFace — runs locally, no API key needed)
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# -----------------------------------------------------------------------------
# Schema
# -----------------------------------------------------------------------------
SCHEMA_YAML_PATH=data/db-schema.yaml

# -----------------------------------------------------------------------------
# Index Cache
# Caches the dense embedding index to disk — reduces startup from ~3.5 min to
# ~5 seconds after the first run. Cache auto-invalidates when db-schema.yaml
# changes. To force a full rebuild without changing the schema, increment
# INDEX_CACHE_VERSION (e.g. 1.0.0 → 1.0.1).
# -----------------------------------------------------------------------------
INDEX_CACHE_DIR=index_cache
INDEX_CACHE_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Retrieval
# -----------------------------------------------------------------------------
TABLE_TOP_K=5
MAX_SQL_RETRIES=2

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
