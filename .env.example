# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# ── SQL Server (REQUIRED) ─────────────────────────────────
# Use a read-only user. The tool will refuse to run INSERT/UPDATE/DELETE anyway,
# but a read-only DB account is an extra safety layer.
DB_SERVER=your-sql-server-ip-or-hostname
DB_NAME=your-database-name
DB_READONLY_USER=your-readonly-username
DB_READONLY_PASSWORD=your-readonly-password

# Optional overrides (defaults shown)
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_CONNECT_TIMEOUT=30
DB_QUERY_TIMEOUT=60
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Groq — primary LLM (REQUIRED) ────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL_NAME=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=2048
GROQ_CONTEXT_WINDOW=32768

# ── Ollama — local fallback LLM (OPTIONAL) ───────────────
# Install Ollama from https://ollama.com and run: ollama pull qwen3:4b
# If Ollama is not running, the tool logs a warning and uses Groq only.
OLLAMA_MODEL_NAME=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REQUEST_TIMEOUT=300
OLLAMA_NUM_CTX=8192

# ── Embedding model (OPTIONAL) ───────────────────────────
# Downloaded automatically from Hugging Face on first run. No API key needed.
EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5

# ── App behaviour (OPTIONAL) ─────────────────────────────
# ROW_CAP        — max rows returned per query (default: 100)
# RETRIEVER_TOP_K — number of tables passed to LLM per query (default: 3)
# MAX_QUERY_LEN  — max characters in a user question (default: 500)
# HISTORY_MAX    — conversation turns kept for follow-up context (default: 5)
# LOG_LEVEL      — DEBUG | INFO | WARNING | ERROR (default: INFO)
# REBUILD_INDEX  — set to 1 to force-rebuild the vector index on next run
ROW_CAP=100
RETRIEVER_TOP_K=5
VALUE_TOP_K=6
MAX_QUERY_LEN=500
HISTORY_MAX=5
LOG_LEVEL=INFO
REBUILD_INDEX=0
# ENABLE_SQL_CRITIQUE — set to 0 to skip SQL self-critique (faster, fewer tokens)
ENABLE_SQL_CRITIQUE=1
# VALUE_SAMPLE_LIMIT — distinct values sampled per column for value grounding index
VALUE_SAMPLE_LIMIT=300
# INDEX DIRECTORIES (optional overrides)
# TABLE_INDEX_DIR=./table_index_storage
# VALUE_INDEX_DIR=./value_index_storage
